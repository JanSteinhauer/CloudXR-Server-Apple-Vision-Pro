# Firebase Configuration
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_API_KEY=your_api_key_here

# CloudXR Configuration (if needed)
CLOUDXR_SERVER_IP=192.168.137.1
CLOUDXR_CLIENT_TOKEN=your_client_token_here

# LiveKit — participant microphone
# The headset joins the same LiveKit room as the Unity server and publishes its
# microphone, so the agent hears the participant. Needed once the server is a
# cloud VM with no microphone of its own.
#
# These four must match the Unity project's Resources assets:
#   LIVEKIT_SERVER_URL      = livekitclient_server_url   (01_LiveKitClient.asset)
#   LIVEKIT_CONTROL_URL     = livekitcontrol_server_url  (02_LiveKitControl.asset)
#   LIVEKIT_CONTROL_USER    = livekitcontrol_user        (02_LiveKitControl.asset)
#   LIVEKIT_CONTROL_API_KEY = livekitcontrol_api_key     (02_LiveKitControl.asset)
#   LIVEKIT_ROOM            = room                       (03_LiveKitSession.asset)
LIVEKIT_SERVER_URL=wss://your-livekit-host
LIVEKIT_CONTROL_URL=https://your-livekit-host:4437
LIVEKIT_CONTROL_USER=your_control_user
LIVEKIT_CONTROL_API_KEY=your_control_api_key
LIVEKIT_ROOM=your_room_id

# Identity the headset publishes under. Keep it distinct from the Unity server's
# local participant so the two are tellable apart in the room.
LIVEKIT_PARTICIPANT_IDENTITY=avp-participant
